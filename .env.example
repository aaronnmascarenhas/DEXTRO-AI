# ---------------------------------------------------------------------------
# DEXTRO AI — example environment
# Copy to `.env` and fill in real values. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret management — AES-256-GCM key used to encrypt provider credentials at
# rest. REQUIRED. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DEXTRO_MASTER_KEY=

# Sandboxed filesystem roots for generated code and uploads.
WORKSPACE_ROOT=./.dextro/workspaces
UPLOAD_ROOT=./.dextro/uploads

# AI provider binding: "mock" is safe for local development. "gemini" and
# "nvidia" are valid production bindings when credentials are supplied.
AI_PROVIDER=mock

# AI provider credentials.
GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=

# Future orchestration limits
MAX_PARALLEL_AGENTS=5
MAX_PLAN_ITERATIONS=3
MAX_ACT_RETRIES=3
MAX_FILE_SIZE_MB=100
